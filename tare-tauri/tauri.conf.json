{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tare",
  "version": "0.1.0",
  "identifier": "com.tare.desktop",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "main-window",
          "description": "Core window APIs for the runtime-created main desktop window.",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging"
          ]
        }
      ],
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
